    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"gpt-4.1-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a B2B sales lead qualification assistant for an AI automation freelancer. Classify each inbound lead as HOT, WARM, or COLD and score it from 1 to 10. HOT means clear business need, realistic budget, clear timeline, and strong purchase intent. WARM means a plausible opportunity but one or more important details are uncertain. COLD means very low intent, unrealistic budget, vague need, or poor fit. Be commercially sensible. Write a short professional reply to the prospect without making promises or inventing facts.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": `Name: ${$json.name}\nCompany: ${$json.company}\nService required: ${$json.service}\nBudget (USD): ${$json.budget}\nTimeline: ${$json.timeline}\nProject description: ${$json.message}`\n    }\n  ],\n  \"response_format\": {\n    \"type\": \"json_schema\",\n    \"json_schema\": {\n      \"name\": \"lead_qualification\",\n      \"strict\": true,\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"lead_status\": {\n            \"type\": \"string\",\n            \"enum\": [\"HOT\", \"WARM\", \"COLD\"]\n          },\n          \"score\": {\n            \"type\": \"integer\",\n            \"minimum\": 1,\n            \"maximum\": 10\n          },\n          \"summary\": {\n            \"type\": \"string\"\n          },\n          \"recommended_action\": {\n            \"type\": \"string\"\n          },\n          \"email_subject\": {\n            \"type\": \"string\"\n          },\n          \"email_reply\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"lead_status\",\n          \"score\",\n          \"summary\",\n          \"recommended_action\",\n          \"email_subject\",\n          \"email_reply\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"temperature\": 0.2,\n  \"max_completion_tokens\": 600\n} }}",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -560,
        0
      ],
      "id": "52a03ba4-c3f0-4044-880f-e0eeb7d11138",
