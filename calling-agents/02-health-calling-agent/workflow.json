  {
   "id": "20000000-0000-4000-8000-000000000003",
   "name": "Filter Upcoming",
   "parameters": {
    "conditions": {
     "combinator": "and",
     "conditions": [
      {
       "id": "cond-status",
       "leftValue": "={{ $json.status }}",
       "operator": {
        "operation": "equals",
        "type": "string"
       },
       "rightValue": "pending"
      },
      {
       "id": "cond-date-from",
       "leftValue": "={{ $json.appointmentDate }}",
       "operator": {
        "operation": "afterOrEquals",
        "type": "dateTime"
       },
       "rightValue": "={{ $now.toISODate() }}"
      },
      {
       "id": "cond-date-to",
       "leftValue": "={{ $json.appointmentDate }}",
       "operator": {
        "operation": "beforeOrEquals",
        "type": "dateTime"
       },
       "rightValue": "={{ $now.plus({ days: 2 }).toISODate() }}"
      }
     ],
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     }
    },
    "options": {
     "looseTypeValidation": true
    }
   },
   "position": [
    480,
    0
   ],
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2
  },
