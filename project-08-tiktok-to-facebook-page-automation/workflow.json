{
  "name": "TikTok to Facebook Page Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1200, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "keyword",
              "type": "string",
              "value": "your search keyword"
            }
          ]
        }
      },
      "name": "Set Keyword",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-980, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://tiktok-scraper2.p.rapidapi.com/search/general/{{ $json.keyword }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "name": "TikTok Search (RapidAPI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-760, 300],
      "notes": "Replace with your chosen RapidAPI TikTok scraper endpoint + credentials"
    },
    {
      "parameters": {
        "fieldToSplitOut": "data.videos",
        "options": {}
      },
      "name": "Split Videos",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [-540, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Loop Over Videos",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-320, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://graph.facebook.com/v19.0/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "type", "value": "page" },
            { "name": "q", "value": "={{ $json.author.nickname }}" },
            { "name": "access_token", "value": "YOUR_FB_APP_TOKEN" }
          ]
        }
      },
      "name": "Check FB Page Exists",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-100, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "leftValue": "", "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.data.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "IF Page NOT Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [120, 200]
    },
    {
      "parameters": {},
      "name": "Skip (Page Exists)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [340, 340]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.video.playAddr }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "name": "Download Video (No Watermark)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [340, 100]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You write short, catchy Facebook captions with 5-8 relevant hashtags based on a video description."
            },
            {
              "role": "user",
              "content": "Video description: {{ $('Loop Over Videos').item.json.desc }}"
            }
          ]
        }
      },
      "name": "Generate Caption (OpenAI)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.5,
      "position": [560, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/YOUR_PAGE_ID/videos",
        "sendBinaryData": true,
        "binaryPropertyName": "data",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "access_token", "value": "YOUR_PAGE_ACCESS_TOKEN" },
            { "name": "description", "value": "={{ $json.message.content }}" }
          ]
        }
      },
      "name": "Upload to Facebook Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 100]
    }
  ],
  "connections": {
    "Schedule Trigger": { "main": [[{ "node": "Set Keyword", "type": "main", "index": 0 }]] },
    "Set Keyword": { "main": [[{ "node": "TikTok Search (RapidAPI)", "type": "main", "index": 0 }]] },
    "TikTok Search (RapidAPI)": { "main": [[{ "node": "Split Videos", "type": "main", "index": 0 }]] },
    "Split Videos": { "main": [[{ "node": "Loop Over Videos", "type": "main", "index": 0 }]] },
    "Loop Over Videos": { "main": [[{ "node": "Check FB Page Exists", "type": "main", "index": 0 }]] },
    "Check FB Page Exists": { "main": [[{ "node": "IF Page NOT Found", "type": "main", "index": 0 }]] },
    "IF Page NOT Found": {
      "main": [
        [{ "node": "Download Video (No Watermark)", "type": "main", "index": 0 }],
        [{ "node": "Skip (Page Exists)", "type": "main", "index": 0 }]
      ]
    },
    "Download Video (No Watermark)": { "main": [[{ "node": "Generate Caption (OpenAI)", "type": "main", "index": 0 }]] },
    "Generate Caption (OpenAI)": { "main": [[{ "node": "Upload to Facebook Page", "type": "main", "index": 0 }]] }
  }
}
